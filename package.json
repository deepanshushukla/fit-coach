{
  "name": "formcoach",
  "private": true,
  "version": "0.1.0",
  "description": "FormCoach monorepo: exercise intelligence SDKs, licensing backend, and management portal",
  "workspaces": [
    "apps/api",
    "apps/portal",
    "apps/demo-react-native",
    "packages/types",
    "packages/core",
    "packages/react-native",
    "packages/web-client"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
