DATABASE_URL="postgresql://localhost:5432/formcoach_dev?schema=public"
PORT=4000
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_SDK_SECRET="dev-sdk-session-secret-change-me"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
SDK_SESSION_TOKEN_TTL_SECONDS=3600
ENTITLEMENT_ISSUER="https://api.formcoach.example"

# "local" stores the entitlement signing private key in Postgres (dev/test only).
# "aws-kms" signs via AWS KMS and never lets the private key leave KMS (production).
SIGNING_KEY_PROVIDER="local"
# Required only when SIGNING_KEY_PROVIDER=aws-kms (region is read by the AWS SDK's
# default credential/region chain, e.g. AWS_REGION/AWS_PROFILE env vars).
# AWS_REGION="us-east-1"

# Unset (default) keeps usage events / audit logs forever. Set to purge rows older than
# N days via `npm run usage:retention-sweep` (intended to be invoked by an external cron).
# USAGE_RETENTION_DAYS=365
# AUDIT_LOG_RETENTION_DAYS=365
