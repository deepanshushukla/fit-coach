{
  "name": "@formcoach/api",
  "version": "0.1.0",
  "description": "FormCoach backend: identity, organisations, licensing, signed entitlements, usage and audit",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "node --import tsx --test --test-concurrency=1 src/__tests__/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "keys:generate": "tsx scripts/generate-entitlement-keypair.ts"
  },
  "dependencies": {
    "@formcoach/types": "0.1.0",
    "@prisma/client": "^5.22.0",
    "express": "^4.21.1",
    "zod": "^3.23.8",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "@paralleldrive/cuid2": "^2.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.2",
    "@types/express": "^4.17.21",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/cors": "^2.8.17",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2"
  }
}
